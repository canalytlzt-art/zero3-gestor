{
  "name": "zero3-gestor",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-26",
  "keep_vars": true,
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zero3-pro-gestao-db",
      "database_id": "e2cf36df-1146-48bc-8975-19d2400410cd",
      "migrations_dir": "../../scripts/d1/migrations"
    }
  ],
  "workers_dev": true
}
